# Voice agent (Pattern C) — environment configuration
# Copy to `.env` and tweak as needed. `docker compose up` reads `.env` automatically.

# ---------- LLM (beellama on RTX 4090) ----------
# Inside the compose network, resolve by service name.
LLM_BASE_URL=http://beellama:8083/v1
LLM_MODEL=Qwen3.5-9B-Q4_K_M
LLM_API_KEY=not-needed
# Streaming chat completion timeout (seconds).
LLM_TIMEOUT_S=30
# System prompt nudge — Kokoro starts synthesis on the first comma, so a brief
# acknowledgement saves 100-200ms of perceived latency (design doc, agent #5).
LLM_SYSTEM_PROMPT=You are a concise voice assistant. Always begin replies with a brief acknowledgement like "Sure," or "Well," then answer in one or two short sentences.

# ---------- STT (faster-whisper on RTX 3090 Ti) ----------
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_BEAM_SIZE=1

# ---------- TTS (Kokoro on RTX 3090 Ti) ----------
TTS_LANG_CODE=a            # 'a' = American English (KPipeline)
TTS_VOICE=af_heart
TTS_SAMPLE_RATE=24000

# ---------- VAD (Silero on CPU) ----------
VAD_THRESHOLD=0.45
VAD_MIN_SILENCE_MS=300     # endpoint silence wait; lower = snappier, higher = fewer mid-pause cutoffs
VAD_SPEECH_PAD_MS=100
VAD_SAMPLE_RATE=16000

# ---------- Server ----------
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info

# ---------- GPU pinning (overridden in compose, but useful for bare-metal runs) ----------
# Audio stack belongs on the 3090 Ti to avoid CUDA serialization stutters with the LLM.
CUDA_VISIBLE_DEVICES=1
